<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="CalculatorSoapEP" xmlns="http://ws.apache.org/ns/synapse">
    <address format="soap11" uri="http://www.dneonline.com/calculator.asmx">
        <timeout>
            <duration>10000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <initialDuration>-1</initialDuration>
            <progressionFactor>1</progressionFactor>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
    </address>
</endpoint>
