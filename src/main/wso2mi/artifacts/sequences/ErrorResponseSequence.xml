<?xml version="1.0" encoding="UTF-8"?>
<!-- Reusable error responder. Callers set: err.status, err.code, err.message -->
<sequence name="ErrorResponseSequence" xmlns="http://ws.apache.org/ns/synapse">
    <payloadFactory media-type="json">
        <format>{"error":{"code":"$1","message":"$2"},"requestId":"$3","timestamp":"$4"}</format>
        <args>
            <arg evaluator="xml" expression="get-property('err.code')"/>
            <arg evaluator="xml" expression="get-property('err.message')"/>
            <arg evaluator="xml" expression="get-property('requestId')"/>
            <arg evaluator="xml" expression="get-property('timestamp')"/>
        </args>
    </payloadFactory>
    <property name="HTTP_SC" expression="get-property('err.status')" scope="axis2"/>
    <property name="messageType" value="application/json" scope="axis2"/>
    <respond/>
</sequence>
